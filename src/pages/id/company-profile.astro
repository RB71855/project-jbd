---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/translations';

const lang = 'id';
const t = useTranslations(lang);
---

<MainLayout title="Profil Perusahaan | PT. Joyo Bada Perkasa" lang={lang}>
  <Navbar lang={lang} currentPath="/id/company-profile" />

  <main class="py-16 lg:py-24 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#64748B] mb-8">
        <a href="/id" class="hover:text-[#0284C7]">{t('cp.breadcrumb.home')}</a>
        <span>/</span>
        <span class="text-[#0A192F]">{t('cp.breadcrumb.current')}</span>
      </nav>

      <!-- Header Section -->
      <div class="max-w-3xl mb-16" data-aos="fade-up">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E0F2FE] border border-[#0284C7]/20 text-[#0284C7] text-xs font-bold uppercase tracking-wider mb-4">
          {t('cp.badge')}
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-[#0A192F] tracking-tight mb-4 font-['Plus_Jakarta_Sans']">
          {t('cp.title')}
        </h1>
        <p class="text-lg text-[#475569] leading-relaxed">
          {t('cp.subtitle')}
        </p>
      </div>

      <!-- Corporate Overview -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20" data-aos="fade-up">
        <div class="lg:col-span-7 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0A192F] font-['Plus_Jakarta_Sans']">
            {t('cp.overview.title')}
          </h2>
          <p class="text-base text-[#475569] leading-relaxed">
            {t('cp.overview.p1')}
          </p>
          <p class="text-base text-[#475569] leading-relaxed">
            {t('cp.overview.p2')}
          </p>
        </div>
        <div class="lg:col-span-5">
          <div class="card-clean p-3 bg-white shadow-xl rounded-2xl">
            <img src="/images/project-1.jpg" alt="Industrial Facility" class="w-full h-80 object-cover rounded-xl"/>
          </div>
        </div>
      </div>

      <!-- Vision & Mission Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20" data-aos="fade-up">
        <div class="card-clean p-8 bg-white flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#0F4C81] text-white flex items-center justify-center font-bold text-lg mb-6 shadow-md">🎯</div>
            <h3 class="text-2xl font-bold text-[#0A192F] mb-4 font-['Plus_Jakarta_Sans']">{t('cp.v.title')}</h3>
            <p class="text-base text-[#475569] leading-relaxed">{t('cp.v.desc')}</p>
          </div>
        </div>
        <div class="card-clean p-8 bg-white flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#0F4C81] text-white flex items-center justify-center font-bold text-lg mb-6 shadow-md">🚀</div>
            <h3 class="text-2xl font-bold text-[#0A192F] mb-4 font-['Plus_Jakarta_Sans']">{t('cp.m.title')}</h3>
            <p class="text-base text-[#475569] leading-relaxed">{t('cp.m.desc')}</p>
          </div>
        </div>
      </div>

      <!-- What Sets Us Apart (3 Pillars) -->
      <div class="mb-20" data-aos="fade-up">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-3xl font-extrabold text-[#0A192F] font-['Plus_Jakarta_Sans']">{t('cp.pillars.title')}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="card-clean p-6 bg-white">
            <div class="text-2xl font-bold text-[#0284C7] mb-3">01</div>
            <h4 class="text-lg font-bold text-[#0A192F] mb-2 font-['Plus_Jakarta_Sans']">{t('cp.p1.title')}</h4>
            <p class="text-sm text-[#475569] leading-relaxed">{t('cp.p1.desc')}</p>
          </div>
          <div class="card-clean p-6 bg-white">
            <div class="text-2xl font-bold text-[#0284C7] mb-3">02</div>
            <h4 class="text-lg font-bold text-[#0A192F] mb-2 font-['Plus_Jakarta_Sans']">{t('cp.p2.title')}</h4>
            <p class="text-sm text-[#475569] leading-relaxed">{t('cp.p2.desc')}</p>
          </div>
          <div class="card-clean p-6 bg-white">
            <div class="text-2xl font-bold text-[#0284C7] mb-3">03</div>
            <h4 class="text-lg font-bold text-[#0A192F] mb-2 font-['Plus_Jakarta_Sans']">{t('cp.p3.title')}</h4>
            <p class="text-sm text-[#475569] leading-relaxed">{t('cp.p3.desc')}</p>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Contact lang={lang} />
  <Footer lang={lang} />
</MainLayout>