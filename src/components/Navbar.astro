---
import { useTranslations } from '../i18n/translations';

interface Props {
  lang?: 'en' | 'id';
  currentPath?: string;
}

const { lang = 'en', currentPath = '' } = Astro.props;
const t = useTranslations(lang);

// Tentukan link target untuk switch bahasa berdasarkan path saat ini
const isId = lang === 'id';
const baseCleanPath = currentPath.replace(/^\/id/, '') || '/';
const switchLangPath = isId ? baseCleanPath : `/id${baseCleanPath === '/' ? '' : baseCleanPath}`;
const profilePath = isId ? '/id/company-profile' : '/company-profile';
const homePath = isId ? '/id' : '/';
const productsPath = `${homePath}#products`;
const aboutPath = `${homePath}#about`;
const projectsPath = `${homePath}#projects`;
const contactPath = `${homePath}#contact`;
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-[#E2E8F0] transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Logo Brand -->
    <a href={homePath} class="flex items-center gap-3 group">
      <div class="w-11 h-11 rounded-full bg-[#0A192F] text-white flex items-center justify-center font-['Plus_Jakarta_Sans'] font-extrabold text-lg shadow-md group-hover:bg-[#0F4C81] transition-colors">
        JBD
      </div>
      <div class="flex flex-col">
        <span class="font-['Plus_Jakarta_Sans'] font-extrabold text-lg text-[#0A192F] tracking-tight leading-tight">
          PT. Joyo Bada Perkasa
        </span>
        <span class="text-xs font-medium text-[#0284C7] tracking-wider uppercase">
          Water & Chemical Specialist
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="hidden md:flex items-center gap-8">
      <a href={homePath} class="font-['Plus_Jakarta_Sans'] font-semibold text-sm text-[#0A192F] hover:text-[#0284C7] transition-colors">{t('nav.home')}</a>
      <a href={aboutPath} class="font-['Plus_Jakarta_Sans'] font-semibold text-sm text-[#64748B] hover:text-[#0284C7] transition-colors">{t('nav.about')}</a>
      <a href={productsPath} class="font-['Plus_Jakarta_Sans'] font-semibold text-sm text-[#64748B] hover:text-[#0284C7] transition-colors">{t('nav.products')}</a>
      <a href={projectsPath} class="font-['Plus_Jakarta_Sans'] font-semibold text-sm text-[#64748B] hover:text-[#0284C7] transition-colors">{t('nav.projects')}</a>
    </nav>

    <!-- Desktop Actions (Language Switcher & CTA) -->
    <div class="hidden md:flex items-center gap-4">
      <!-- Language Switcher -->
      <div class="lang-switch">
        <a href={baseCleanPath} class={`lang-btn ${!isId ? 'active' : ''}`}>EN</a>
        <a href={`/id${baseCleanPath === '/' ? '' : baseCleanPath}`} class={`lang-btn ${isId ? 'active' : ''}`}>ID</a>
      </div>

      <a href={contactPath} class="btn-primary text-sm py-2.5 px-5">
        {t('nav.contact')}
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button id="menu-btn" aria-label="Toggle Menu" class="md:hidden p-2 rounded-xl text-[#0A192F] hover:bg-[#F1F5F9] focus:outline-none">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-white border-b border-[#E2E8F0] shadow-xl py-6 px-6 transition-all">
    <div class="flex flex-col gap-4">
      <a href={homePath} class="mobile-link font-['Plus_Jakarta_Sans'] font-semibold text-base text-[#0A192F] hover:text-[#0284C7] py-2">{t('nav.home')}</a>
      <a href={aboutPath} class="mobile-link font-['Plus_Jakarta_Sans'] font-semibold text-base text-[#64748B] hover:text-[#0284C7] py-2">{t('nav.about')}</a>
      <a href={productsPath} class="mobile-link font-['Plus_Jakarta_Sans'] font-semibold text-base text-[#64748B] hover:text-[#0284C7] py-2">{t('nav.products')}</a>
      <a href={projectsPath} class="mobile-link font-['Plus_Jakarta_Sans'] font-semibold text-base text-[#64748B] hover:text-[#0284C7] py-2">{t('nav.projects')}</a>
      
      <div class="flex items-center justify-between pt-2 pb-2 border-t border-[#E2E8F0]">
        <span class="text-xs font-bold text-[#64748B] uppercase">Language / Bahasa</span>
        <div class="lang-switch">
          <a href={baseCleanPath} class={`lang-btn ${!isId ? 'active' : ''}`}>EN</a>
          <a href={`/id${baseCleanPath === '/' ? '' : baseCleanPath}`} class={`lang-btn ${isId ? 'active' : ''}`}>ID</a>
        </div>
      </div>

      <div class="pt-2">
        <a href={contactPath} class="mobile-link btn-primary w-full text-center py-3">{t('nav.contact')}</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('.mobile-link');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });

      links.forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
        });
      });
    }
  });
</script>