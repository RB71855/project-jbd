---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/translations';

interface Props {
  lang?: 'en' | 'id';
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

// Ambil data produk dari Content Collection Keystatic
const allProducts = await getCollection('products');

// Pisahkan berdasarkan kategori 'water' dan 'chemicals'
const waterProducts = allProducts.filter(p => p.data.category === 'water');
const chemicalProducts = allProducts.filter(p => p.data.category === 'chemicals');
---

<section id="products" class="py-20 lg:py-28 bg-[#F8FAFC] border-b border-[#E2E8F0]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header & Search/Filter Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6" data-aos="fade-up">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E0F2FE] border border-[#0284C7]/20 text-[#0284C7] text-xs font-bold uppercase tracking-wider mb-4">
          {t('prod.badge')}
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0A192F] tracking-tight">
          {t('prod.title')}
        </h2>
      </div>

      <!-- Search Bar -->
      <div class="w-full md:w-80">
        <div class="relative">
          <input 
            type="text" 
            id="product-search" 
            placeholder={t('prod.search.placeholder')} 
            class="w-full bg-white border border-[#E2E8F0] rounded-xl px-4 py-3 pl-11 text-sm text-[#0A192F] focus:outline-none focus:border-[#0284C7] shadow-sm transition-all"
          />
          <svg class="w-5 h-5 text-[#64748B] absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    </div>

<!-- Tab Navigation -->
    <div class="flex items-center justify-center mb-10" data-aos="fade-up">
      <div class="bg-white p-1.5 rounded-2xl border border-[#E2E8F0] shadow-sm inline-flex gap-2">
        <button id="tab-water" class="tab-btn px-6 py-2.5 rounded-xl font-['Plus_Jakarta_Sans'] font-semibold text-sm transition-all bg-[#0F4C81] text-white shadow-sm" data-target="water-section">
          {lang === 'id' ? 'Pengolahan Air' : 'Water Treatment'} ({waterProducts.length} {lang === 'id' ? 'Item' : 'Items'})
        </button>
        <button id="tab-chemical" class="tab-btn px-6 py-2.5 rounded-xl font-['Plus_Jakarta_Sans'] font-semibold text-sm transition-all text-[#64748B] hover:text-[#0A192F]" data-target="chemical-section">
          {lang === 'id' ? 'Bahan Kimia' : 'Chemicals'} ({chemicalProducts.length} {lang === 'id' ? 'Item' : 'Items'})
        </button>
      </div>
    </div>

    <!-- TAB 1: Water Treatment Products -->
    <div id="water-section" class="product-grid-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-aos="fade-up">
      {waterProducts.map((product) => {
        const title = lang === 'id' ? product.data.titleId : product.data.titleEn;
        const desc = lang === 'id' ? product.data.descId : product.data.descEn;
        const tag = lang === 'id' ? product.data.tagId : product.data.tagEn;
        return (
          <div class="card-clean p-6 bg-white flex flex-col justify-between product-card" data-name={title.toLowerCase()} data-desc={desc.toLowerCase()}>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 bg-[#E0F2FE] text-[#0284C7] text-xs font-bold rounded-lg uppercase">Water Treatment</span>
                <span class="text-xs font-semibold text-[#64748B] font-mono">{product.data.code}</span>
              </div>
              <h3 class="text-xl font-bold text-[#0A192F] mb-2 font-['Plus_Jakarta_Sans']">{title}</h3>
              <p class="text-sm text-[#475569] leading-relaxed mb-4">{desc}</p>
            </div>
            <div class="pt-4 border-t border-[#E2E8F0] flex items-center justify-between">
              <span class="text-xs font-medium text-[#64748B]">{tag}</span>
              <a href="#contact" class="inquire-btn text-xs font-bold text-[#0F4C81] hover:text-[#0284C7] flex items-center gap-1" data-product={title}>
                {t('prod.inquire')}
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- TAB 2: Chemicals Products -->
    <div id="chemical-section" class="product-grid-container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 hidden" data-aos="fade-up">
      {chemicalProducts.map((product) => {
        const title = lang === 'id' ? product.data.titleId : product.data.titleEn;
        const desc = lang === 'id' ? product.data.descId : product.data.descEn;
        const tag = lang === 'id' ? product.data.tagId : product.data.tagEn;
        return (
          <div class="card-clean p-6 bg-white flex flex-col justify-between product-card" data-name={title.toLowerCase()} data-desc={desc.toLowerCase()}>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 bg-[#0A192F] text-white text-xs font-bold rounded-lg font-mono">{product.data.code}</span>
                <span class="text-xs font-semibold text-[#64748B]">Chemicals</span>
              </div>
              <h3 class="text-xl font-bold text-[#0A192F] mb-1 font-['Plus_Jakarta_Sans']">{title}</h3>
              <p class="text-xs font-bold text-[#0284C7] uppercase tracking-wider mb-3">Speciality Chemical</p>
              <p class="text-sm text-[#475569] leading-relaxed mb-4">{desc}</p>
            </div>
            <div class="pt-4 border-t border-[#E2E8F0] flex items-center justify-between">
              <span class="text-xs font-medium text-[#64748B]">{tag}</span>
              <a href="#contact" class="inquire-btn text-xs font-bold text-[#0F4C81] hover:text-[#0284C7] flex items-center gap-1" data-product={title}>
                {t('prod.inquire')}
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabWater = document.getElementById('tab-water');
    const tabChemical = document.getElementById('tab-chemical');
    const waterSec = document.getElementById('water-section');
    const chemSec = document.getElementById('chemical-section');
    const searchInput = document.getElementById('product-search');

    if (tabWater && tabChemical && waterSec && chemSec) {
      tabWater.addEventListener('click', () => {
        tabWater.className = "tab-btn px-6 py-2.5 rounded-xl font-['Plus_Jakarta_Sans'] font-semibold text-sm transition-all bg-[#0F4C81] text-white shadow-sm";
        tabChemical.className = "tab-btn px-6 py-2.5 rounded-xl font-['Plus_Jakarta_Sans'] font-semibold text-sm transition-all text-[#64748B] hover:text-[#0A192F]";
        waterSec.classList.remove('hidden');
        chemSec.classList.add('hidden');
      });

      tabChemical.addEventListener('click', () => {
        tabChemical.className = "tab-btn px-6 py-2.5 rounded-xl font-['Plus_Jakarta_Sans'] font-semibold text-sm transition-all bg-[#0F4C81] text-white shadow-sm";
        tabWater.className = "tab-btn px-6 py-2.5 rounded-xl font-['Plus_Jakarta_Sans'] font-semibold text-sm transition-all text-[#64748B] hover:text-[#0A192F]";
        chemSec.classList.remove('hidden');
        waterSec.classList.add('hidden');
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        const cards = document.querySelectorAll('.product-card');

        cards.forEach(card => {
          const name = card.getAttribute('data-name') || '';
          const desc = card.getAttribute('data-desc') || '';
          if (name.includes(query) || desc.includes(query)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }

    const inquireBtns = document.querySelectorAll('.inquire-btn');
    inquireBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const prodName = btn.getAttribute('data-product');
        const contactInput = document.getElementById('contact-subject');
        if (contactInput) {
          contactInput.value = `Inquiry regarding: ${prodName}`;
        }
      });
    });
  });
</script>