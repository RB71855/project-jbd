---
import { getEntry } from 'astro:content';
import { useTranslations } from '../i18n/translations';

interface Props {
  lang?: 'en' | 'id';
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const homePath = lang === 'id' ? '/id' : '/';
const aboutPath = `${homePath}#about`;
const productsPath = `${homePath}#products`;
const projectsPath = `${homePath}#projects`;
const contactPath = `${homePath}#contact`;

// Ambil data singleton settings dari Keystatic CMS dengan fallback aman
const settingsEntry = await getEntry('settings', 'company');
const companySettings = settingsEntry ? settingsEntry.data : {
  address: "18 Office Park, Lt. 25, Jl. TB Simatupang No. Kav 18 RT. 02/RW. 01, Kebagusan, Ps Minggu, Jakarta Selatan, DKI Jakarta",
  phone: "(021) 50633500",
  whatsapp: "+62 812 9610 9466"
};
---

<footer class="bg-[#0A192F] text-white border-t border-white/10 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      
      <!-- Col 1: Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-[#0284C7] text-white flex items-center justify-center font-['Plus_Jakarta_Sans'] font-extrabold text-base shadow-md">JBD</div>
          <span class="font-['Plus_Jakarta_Sans'] font-extrabold text-base text-white tracking-tight">PT. Joyo Bada Perkasa</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">{t('footer.desc')}</p>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h4 class="text-xs font-bold text-white uppercase tracking-widest mb-4 font-['Plus_Jakarta_Sans']">{t('footer.links')}</h4>
        <ul class="space-y-2.5 text-sm text-slate-400">
          <li><a href={homePath} class="hover:text-[#0284C7] transition-colors">{t('nav.home')}</a></li>
          <li><a href={aboutPath} class="hover:text-[#0284C7] transition-colors">{t('nav.about')}</a></li>
          <li><a href={productsPath} class="hover:text-[#0284C7] transition-colors">{t('nav.products')}</a></li>
          <li><a href={projectsPath} class="hover:text-[#0284C7] transition-colors">{t('nav.projects')}</a></li>
          <li><a href={contactPath} class="hover:text-[#0284C7] transition-colors">{t('nav.contact')}</a></li>
        </ul>
      </div>

      <!-- Col 3: Principal Brands -->
      <div>
        <h4 class="text-xs font-bold text-white uppercase tracking-widest mb-4 font-['Plus_Jakarta_Sans']">{t('footer.principals')}</h4>
        <ul class="space-y-2.5 text-sm text-slate-400">
          <li>DuPont™ AmberLite</li>
          <li>Lanxess Lewatit®</li>
          <li>Toray Industries</li>
          <li>Hydranautics</li>
          <li>Veolia Water Technologies</li>
        </ul>
      </div>

      <!-- Col 4: Office Location Dinamis -->
      <div>
        <h4 class="text-xs font-bold text-white uppercase tracking-widest mb-4 font-['Plus_Jakarta_Sans']">{t('footer.hq')}</h4>
        <p class="text-xs text-slate-400 leading-relaxed mb-3">{companySettings.address}</p>
        <p class="text-xs text-[#0284C7] font-semibold">Phone: {companySettings.phone}</p>
      </div>

    </div>

    <!-- Bottom Copyright Divider -->
    <div class="pt-8 border-t border-white/10 text-center">
      <p class="text-xs text-slate-400">{t('footer.copy')}</p>
    </div>

  </div>
</footer>