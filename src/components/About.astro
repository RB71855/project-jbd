---
import { useTranslations } from '../i18n/translations';

interface Props {
  lang?: 'en' | 'id';
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const profileLink = lang === 'id' ? '/id/company-profile' : '/company-profile';
---

<section id="about" class="py-20 lg:py-28 bg-white border-b border-[#E2E8F0] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16" data-aos="fade-up">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E0F2FE] border border-[#0284C7]/20 text-[#0284C7] text-xs font-bold uppercase tracking-wider mb-4">
        {t('about.badge')}
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0A192F] tracking-tight mb-4">
        {t('about.title')}
      </h2>
      <p class="text-[#475569] text-base sm:text-lg leading-relaxed">
        {t('about.desc')}
      </p>
    </div>

    <!-- 9 Industry Sectors Grid -->
    <div class="mb-20" data-aos="fade-up">
      <h3 class="text-xs font-bold text-[#64748B] uppercase tracking-widest text-center mb-8">
        {t('about.sectors.label')}
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-9 gap-3">
        <div class="card-clean p-4 text-center bg-[#F8FAFC]"><span class="text-xs font-semibold text-[#0A192F] block">{t('sector.power')}</span></div>
        <div class="card-clean p-4 text-center bg-[#F8FAFC]"><span class="text-xs font-semibold text-[#0A192F] block">{t('sector.oil')}</span></div>
        <div class="card-clean p-4 text-center bg-[#F8FAFC]"><span class="text-xs font-semibold text-[#0A192F] block">{t('sector.petro')}</span></div>
        <div class="card-clean p-4 text-center bg-[#F8FAFC]"><span class="text-xs font-semibold text-[#0A192F] block">{t('sector.mining')}</span></div>
        <div class="card-clean p-4 text-center bg-[#F8FAFC]"><span class="text-xs font-semibold text-[#0A192F] block">{t('sector.fnb')}</span></div>
        <div class="card-clean p-4 text-center bg-[#F8FAFC]"><span class="text-xs font-semibold text-[#0A192F] block">{t('sector.pharma')}</span></div>
        <div class="card-clean p-4 text-center bg-[#F8FAFC]"><span class="text-xs font-semibold text-[#0A192F] block">{t('sector.mfg')}</span></div>
        <div class="card-clean p-4 text-center bg-[#F8FAFC]"><span class="text-xs font-semibold text-[#0A192F] block">{t('sector.textile')}</span></div>
        <div class="card-clean p-4 text-center bg-[#F8FAFC]"><span class="text-xs font-semibold text-[#0A192F] block">{t('sector.municipal')}</span></div>
      </div>
    </div>

    <!-- Core Values Cards (4 Grid Sejajar) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" data-aos="fade-up" data-aos-delay="100">
      
      <!-- Value 1 -->
      <div class="card-clean p-6 bg-[#F8FAFC] flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[#0F4C81] text-white flex items-center justify-center font-bold text-lg mb-4 shadow-md">01</div>
          <h4 class="text-lg font-bold text-[#0A192F] mb-2 font-['Plus_Jakarta_Sans']">{t('val.1.title')}</h4>
          <p class="text-sm text-[#475569] leading-relaxed">{t('val.1.desc')}</p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#E2E8F0]">
          <span class="text-xs font-bold text-[#0284C7] uppercase tracking-wider">{t('val.1.tag')}</span>
        </div>
      </div>

      <!-- Value 2 -->
      <div class="card-clean p-6 bg-[#F8FAFC] flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[#0F4C81] text-white flex items-center justify-center font-bold text-lg mb-4 shadow-md">02</div>
          <h4 class="text-lg font-bold text-[#0A192F] mb-2 font-['Plus_Jakarta_Sans']">{t('val.2.title')}</h4>
          <p class="text-sm text-[#475569] leading-relaxed">{t('val.2.desc')}</p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#E2E8F0]">
          <span class="text-xs font-bold text-[#0284C7] uppercase tracking-wider">{t('val.2.tag')}</span>
        </div>
      </div>

      <!-- Value 3 -->
      <div class="card-clean p-6 bg-[#F8FAFC] flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[#0F4C81] text-white flex items-center justify-center font-bold text-lg mb-4 shadow-md">03</div>
          <h4 class="text-lg font-bold text-[#0A192F] mb-2 font-['Plus_Jakarta_Sans']">{t('val.3.title')}</h4>
          <p class="text-sm text-[#475569] leading-relaxed">{t('val.3.desc')}</p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#E2E8F0]">
          <span class="text-xs font-bold text-[#0284C7] uppercase tracking-wider">{t('val.3.tag')}</span>
        </div>
      </div>

      <!-- Value 4 -->
      <div class="card-clean p-6 bg-[#F8FAFC] flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-[#0F4C81] text-white flex items-center justify-center font-bold text-lg mb-4 shadow-md">04</div>
          <h4 class="text-lg font-bold text-[#0A192F] mb-2 font-['Plus_Jakarta_Sans']">{t('val.4.title')}</h4>
          <p class="text-sm text-[#475569] leading-relaxed">{t('val.4.desc')}</p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#E2E8F0]">
          <span class="text-xs font-bold text-[#0284C7] uppercase tracking-wider">{t('val.4.tag')}</span>
        </div>
      </div>

    </div>

    <!-- Company Profile Link CTA -->
    <div class="mt-12 text-center" data-aos="fade-up">
      <a href={profileLink} class="btn-outline text-sm py-3 px-8 inline-flex items-center gap-2">
        {t('about.cta')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

  </div>
</section>